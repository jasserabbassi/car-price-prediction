# Trained-model artefacts.
# Models are committed to the repo so the Streamlit Community Cloud deployment
# can serve predictions without retraining on every cold start.
# Re-running `python train_model.py` regenerates everything in models/.
*.h5
*.joblib

# Pickles outside models/ are still ignored.
/*.pkl
**/data/*.pkl

# Data caches (the canonical CSVs are downloaded by scripts/prepare_dataset.py)
data/car_price_kaggle_raw.csv
data/car_price_kaggle_smoke.csv

